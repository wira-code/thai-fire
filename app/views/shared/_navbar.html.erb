
<nav class="navbar navbar-expand-lg navbar-light bg-secondary-subtle border-bottom sticky-top py-1">
  <div class="container-fluid px-4">

    <!-- 1. LOGO ทางซ้าย -->
    <%= link_to root_path, class: "navbar-brand d-flex align-items-center me-4 text-decoration-none" do %>
    <%= image_tag "logo.jpeg", alt: "Thai Fire Logo", class: "img-fluid rounded-4 shadow-sm", style: "height: 80px; width: auto object-fit: cover;" %>

    <% end %>

    <!-- ปุ่ม Hamburger บนมือถือ -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- 2. เมนูตรงกลาง (สไตล์ภาพที่ 2) -->
    <div class="collapse navbar-collapse" id="mainNavbar">
      <ul class="navbar-nav w-100 justify-content-between align-items-center mb-0 text-nowrap gap-2" style="font-size: 17px;">
        <li class="nav-item">
          <%= link_to "HOME", root_path, class: "nav-link px-2 fw-bold text-white bg-danger rounded-0 #{'active' if current_page?(root_path)}", style: "background-color: #b81c24 !important;" %>
        </li>
        <% Category.where(active: true).order(:position).each do |category| %>
          <li class="nav-item px-1">
            <% is_active = (controller_name == 'categories' && params[:id].to_i == category.id) || (params[:category_id].to_i == category.id) %>
            <%= link_to category.name.upcase, category_path(category), #class: "nav-link px-3 fw-bold text-nowrap #{'active' if current_page?(category_path(category))}"
            class: "nav-link px-1 fw-bold text-nowrap #{'border-bottom border-2 border-danger fw-bold' if is_active}" %>
          </li>
          <% end %>
          <li class="nav-item me-3">
            <%= link_to "CONTACT", contact_path, class: "nav-link px-2 fw-bold text-dark #{'border-bottom border-2 border-danger fw-bold''active' if current_page?(contact_path)}" %>
          </li>
        <%# if current_user&.admin? %>
          <% if user_signed_in? && current_user.admin? %>
            <li class="nav-item">
              <%= link_to "DASHBOARD", admin_dashboard_path, class: "nav-link px-2 fw-bold text-dark" %>
            </li>
          <% end %>
      </ul>
      <!-- 2. ส่วนแสดงชื่อผู้ใช้ (สมาชิก / Guest) และปุ่ม Log in/Logout -->
      <div class="d-flex align-items-center">
        <!-- แสดงชื่อผู้ใช้ หรือ Guest -->
        <div class="row text-white small fw-bold d-inline-flex align-items-center text-nowrap me-2 ms-2">
          <i class="bi bi-person-circle fs-5 me-1 text-warning">  Hi,</i>
          <% if user_signed_in? %>
            <span class="text-white fs-6"><%= current_user.first_name.presence || current_user.email.split('@').first %></span>
          <% else %>
            <span class="text-white fs-6">Guest</span>
          <% end %>
        </div>

      <!-- 3. ปุ่มขวาสุด (ปุ่ม RESERVE ขอบมนสีแดง) -->
      <div class="d-flex align-items-center gap-2">
        <!-- ปุ่ม Action ขวาสุดตามภาพที่ 2 -->
        <%= link_to reserve_path, class: "btn btn-outline-danger fw-bold rounded-4 px-2 py-2 ms-2 d-flex align-items-center text-nowrap", style: "color: #b81c24; border-color: #b81c24;" do %>
          📅 RESERVE
        <% end %>

        <!-- ปุ่ม ตะกร้าสินค้า -->
        <%= link_to cart_path, class: "btn btn-outline-danger rounded-4 px-2 py-2 d-flex align-items-center text-nowrap position-relative gap-2" do %>
          🛒 Cart <span id="cart_count" class="badge bg-danger">
            <%= current_cart.cart_items.sum(:quantity) %></span>
        <% end %>
        <!--
        <a href="<%= cart_path %>" class="btn btn-outline-danger rounded-pill">
          🛒 ตะกร้า <span class="badge bg-danger"><%= current_cart.cart_items.sum(:quantity) %></span>
        </a> -->


        <!-- เช็กการ Sign in ของ Devise -->
        <% if user_signed_in? %>
          <%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, class: "tn btn-sm btn-link text-secondary text-decoration-none text-nowrap ms-2" %>
        <% else %>
          <%= link_to new_user_session_path, class: "btn btn-outline-primary rounded-4 px-2 py-2 fw-bold text-decoration-none d-inline-flex align-items-center text-nowrap" do %>
        <i class="bi bi-person-fill me-1"></i> Log in
        <% end %>
  <!--class: "btn btn-link text-orange text-decoration-none fw-bold btn-outline-sm text-nowrap" -->
        <% end %>
      </div>
    </div>

  </div>
</nav>
