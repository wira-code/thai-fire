<div class="container my-4" style="max-width: 800px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <%# ใช้ order_number ถ้ามี ถ้าไม่มีใช้ id %>
    <h3 class="fw-bold mb-0">📄 Order details #<%= @order.try(:order_number) || @order.try(:id) %></h3>
    <%= link_to "← Back to Order lists", admin_orders_path, class: "btn btn-outline-secondary rounded-3" %>
  </div>

  <% if @order.present? %>
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="transform: none !important; transition: none !important;">
      <div class="row g-3 border-bottom pb-3 mb-3">
        <div class="col-6">
          <small class="text-muted d-block">Customer Name</small>
          <strong>
            <%#= @order.user.try(:first_name) || @order.user.try(:name) || @order.user.try(:email) || "Customer" %>
            <%= @order.user.try(:first_name) || @order.user.try(:name) || @order.user.try(:username) || @order.try(:customer_name) || "ไม่ระบุชื่อ" %>
          </strong>
        </div>
        <div class="col-6 text-end">
          <small class="text-muted d-block">Status</small>
          <span class="badge px-3 py-2 rounded-pill fw-bold
            <%= order_status_badge_class(@order.status) %>">
            <%= @order.status.to_s.upcase %>
          </span>
        </div>
      </div>

      <h5 class="fw-bold mb-3 text-danger">🛒 Menu Lists</h5>
      <div class="table-responsive mb-3">
        <table class="table align-middle">
          <thead>
            <tr>
              <th>Menu</th>
              <th class="text-center">QTY</th>
              <th class="text-end">Price/Unit</th>
              <th class="text-end">Total</th>
            </tr>
          </thead>
          <tbody>
            <% if @order_items.any? %>
              <% @order_items.each do |item| %>
                <tr>
                  <td class="fw-bold border-bottom-0"><%= item.product.try(:name) || "สินค้า" %></td>
                  <td class="text-center  border-bottom-0"><%= item.quantity %></td>
                  <td class="text-end  border-bottom-0">€<%= number_with_precision((item.try(:unit_price_cents) || item.try(:price) || 0) / 100.0, precision: 2) %></td>
                  <td class="text-end fw-bold  border-bottom-0">€<%= number_with_precision((item.quantity * (item.try(:unit_price_cents) || item.try(:price) || 0)) / 100.0, precision: 2) %></td>
                </tr>
              <% end %>
            <% else %>
              <tr class="border-bottom-0">
                <td colspan="4" class="text-center text-muted">No item in order</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="d-flex justify-content-between align-items-center pt-3 border-top">
        <h5 class="fw-bold mb-0">Total price</h5>
        <h4 class="fw-bold text-danger mb-0">
          €<%= number_with_precision((@order.try(:total_price_cents) || @order.try(:total_price) || 0), precision: 2) %>
        </h4>
      </div>
    </div>
  <% else %>
    <div class="alert alert-warning text-center">ไม่พบข้อมูลออเดอร์นี้</div>
  <% end %>

  <% if @order.completed? && !@order.review %>
  <div class="card bg-dark text-white border-secondary p-4 mt-4">
    <h4 class="fw-bold text-brand-orange mb-3">⭐ ให้คะแนนและรีวิวออเดอร์นี้</h4>

    <%= form_with(model: [@order, Review.new], local: true) do |f| %>
      <div class="mb-3">
        <%= f.label :rating, "คะแนนความพึงพอใจ", class: "form-label fw-bold" %>
        <%= f.select :rating, [["5 ดาว - ประทับใจมาก", 5], ["4 ดาว - ดีมาก", 4], ["3 ดาว - ปานกลาง", 3], ["2 ดาว - พอใช้", 2], ["1 ดาว - ควรปรับปรุง", 1]], { prompt: "-- เลือกให้คะแนน --" }, { class: "form-select bg-dark text-white border-secondary", required: true } %>
      </div>

      <div class="mb-3">
        <%= f.label :comment, "ข้อความรีวิวเพิ่มเติม", class: "form-label" %>
        <%= f.text_area :comment, rows: 3, class: "form-control bg-dark text-white border-secondary", placeholder: "รสชาติอาหาร, ความเร็วในการจัดส่ง..." %>
      </div>

      <%= f.submit "ส่งรีวิว", class: "btn btn-warning fw-bold px-4" %>
    <% end %>
  </div>
  <% elsif @order.review %>
    <div class="alert alert-info mt-4">
      <strong>รีวิวของคุณ:</strong> <%= "⭐" * @order.review.rating %> <br>
      <%= @order.review.comment %>
    </div>
  <% end %>
</div>
