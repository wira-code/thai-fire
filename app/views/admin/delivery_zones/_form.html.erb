
<%= form_with(model: [:admin, delivery_zone], local: true) do |f| %>
  <div class="mb-3">
    <%= f.label :name, "Area Name", class: "form-label fw-bold text-white" %>
    <%= f.text_field :name, class: "form-control bg-dark text-white border-secondary", placeholder: "e.g. Sarrola-Carcopino", required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :postal_code, "Postal Code", class: "form-label fw-bold text-white" %>
    <%= f.text_field :postal_code, class: "form-control bg-dark text-white border-secondary", placeholder: "e.g. 20167", required: true %>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :delivery_fee_cents, "Delivery Fee (in Cents - e.g. 250 = €2.50)", class: "form-label fw-bold text-white" %>
      <%= f.number_field :delivery_fee_cents, class: "form-control bg-dark text-white border-secondary", step: 1, required: true %>
    </div>

    <div class="col-md-6 mb-3">
      <%= f.label :minimum_order_cents, "Minimum Order (in Cents - e.g. 1500 = €15.00)", class: "form-label fw-bold text-white" %>
      <%= f.number_field :minimum_order_cents, class: "form-control bg-dark text-white border-secondary", step: 1, required: true %>
    </div>
  </div>

  <div class="mb-4 form-check">
    <%= f.check_box :active, class: "form-check-input", id: "activeCheck" %>
    <%= f.label :active, "Active (Show in checkout select options)", class: "form-check-label text-white", for: "activeCheck" %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit "Save Delivery Zone", class: "btn btn-warning fw-bold px-4" %>
    <%= link_to "Cancel", admin_delivery_zones_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
