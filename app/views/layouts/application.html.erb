<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Thai Fire" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Thai Fire">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <!-- บรรทัดสำคัญ: ดึงไฟล์ CSS มาใช้งานในเว็บ -->
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <!-- 1. ดึง Bootstrap 5 CSS ผ่าน CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- 2. ดึง Bootstrap JS (เพื่อให้เมนู Dropdown / Toggle บนมือถือกดได้) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <!-- ดึง Navbar มาแสดงผลทุกหน้า -->
    <%= render "shared/navbar" %>

    <!-- Flash Messages แบบลอยมุมขวาบน (ไม่ดันเนื้อหาลงมา) -->
    <div id="flash-messages" class="position-fixed top-0 end-0 p-3" style="z-index: 1080;">
      <% flash.each do |type, message| %>
        <div data-controller="flash" class="toast show align-items-center text-white bg-dark border border-warning rounded-3 shadow-lg" role="alert">
          <div class="d-flex">
            <div class="toast-body fw-bold text-warning">
              <i class="bi bi-check-circle-fill me-2"></i> <%= message %>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-action="click->flash#dismiss"></button>
          </div>
        </div>
      <% end %>
    </div>

    <%= yield %>

    <%# ซ่อน Mini Cart หากอยู่ในฝั่ง admin, Devise หรือหน้า Contact %>
    <% is_admin_page = controller_path.start_with?('admin/') %>
    <% is_admin_user = current_user&.admin? %>
    <% is_devise_page = respond_to?(:devise_controller?) && devise_controller? %>
    <% is_contact_page = (controller_name == 'pages' && action_name == 'contact') || request.path == '/contact' %>
    <% is_cart_page = (controller_name == 'carts' && action_name == 'show') || request.path == '/cart' %>
    <% is_checkout_page = controller_name == 'orders' || controller_name == 'checkouts' || request.path.include?('checkout') %>
    <%# is_checkout_page = (controller_name == 'orders' && action_name == 'checkout') || request.path == '/checkout' %>


    <%# แปะ Mini Cart ไว้ล่างสุดของ Layout %>
    <%# แสดง Mini Cart เฉพาะหน้าที่ไม่ได้อยู่ใน admin namespace %>
    <% unless is_admin_page ||is_admin_user || is_devise_page || is_contact_page || is_cart_page || is_checkout_page %>
      <%= render 'shared/mini_cart' %>
    <% end %>
  </body>
</html>
