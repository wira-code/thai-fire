<div class="container d-flex justify-content-center align-items-center min-vh-80 my-5">
  <div class="card p-4 p-md-5 rounded-4 shadow-lg text-white" style="width: 100%; max-width: 400px; background-color: #1a1a1a; border: 1px solid #2d2d2d;">
   <!-- 👈 ms-md-5 คือการดันระยะขอบซ้ายเข้ามาทางขวา -->

      <h2 class="text-brand-orange text-center fw-bold mb-4">Log in</h2>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <!-- 2. ขยายช่องกรอกข้อมูลให้กว้างเต็มกรอบ (w-100) -->
      <div class="mb-3">
        <%= f.label :email, class: "form-label text-white-50 fw-semibold mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control w-100 bg-dark text-white border-secondary py-2" %>
      </div>

      <div class="mb-3">
        <%= f.label :password, class: "form-label text-white-50 fw-semibold mb-1" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "form-control w-100 bg-dark text-white border-secondary py-2" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="form-check mb-4">
          <%= f.check_box :remember_me, class: "form-check-input me-2" %>
          <%= f.label :remember_me, class: "form-check-label text-white-50 small" %>
        </div>
      <% end %>

      <!-- 3. ปุ่ม Log in สีส้มเต็มความกว้าง -->
      <div class="actions">
        <%= f.submit "Log in", class: "btn w-100 fw-bold py-2 rounded-4 text-white shadow-sm mb-3", style: "background-color: #ff6600; border: none;" %>
      </div>
    <% end %>

    <!-- ลิงก์ด้านล่าง -->
    <div class="text-center mt-3 pt-3 border-top border-secondary">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
